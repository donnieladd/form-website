# Paths are ANCHORED with a leading slash on purpose. An unanchored pattern like
# `nav-footer.css` would also match `intel/nav-footer.css` and strip the nav and
# footer off every page.

# 278MB of unreferenced Replit upload scratch
/attached_assets/

# Archives and build sources — not part of the shipped site
/_first-attempt/
/_build/

# Local dev server (Replit). Vercel serves this statically; no runtime needed.
/server.py
/main.py
/pyproject.toml
/replit.nix
/replit.md
/.replit
/__pycache__/
/scripts/
/screenshots/
/.claude/

# Working docs, not web content
/DECISIONS.md
/TALKING-POINTS.md
/SERVICES-COPY.md
/FORM_UI_DOCTRINE.md
/PERFORMANCE_BUDGET.md
/CHANGELOG.md
/README.md


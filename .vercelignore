# Paths are ANCHORED with a leading slash on purpose. An unanchored pattern like
# `nav-footer.css` would also match `intel/nav-footer.css` and strip the nav and
# footer off every page.

# 278MB of unreferenced Replit upload scratch
/attached_assets/

# Archives and build sources — not part of the shipped site
/_first-attempt/
/_build/

# Local dev server (Replit). Vercel serves this statically; no runtime needed.
/server.py
/main.py
/pyproject.toml
/replit.nix
/replit.md
/.replit
/__pycache__/
/scripts/
/screenshots/
/.claude/

# Working docs, not web content
/DECISIONS.md
/TALKING-POINTS.md
/SERVICES-COPY.md
/FORM_UI_DOCTRINE.md
/PERFORMANCE_BUDGET.md
/CHANGELOG.md
/README.md

# Design sources — not web content. (The first-attempt CSS/JS that used to be
# listed here was deleted 2026-08-13 rather than ignored: it shipped nowhere
# and cost only comprehension. The anchoring rule at the top of this file
# still applies to every pattern below — see the nav-footer.css incident.)
/design-refs/
/brand-kit/

# Unreferenced media from the first attempt
/home-bg.mp4
/home-bg.webm
/home-bg.av1.webm
/home-bg.avif
/founder-1.png
/founder-1.avif
/founder-1-cutout.png
/founder-5.png
